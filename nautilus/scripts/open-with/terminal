#!/usr/bin/env bash
# ide-realpath-portable-nautilus

set -Eeuo pipefail

runtime="${XDG_DATA_HOME:-$HOME/.local/share}/ide-realpath/ide-realpath-setup"
if [[ ! -x "$runtime" ]]; then
    printf 'Error: ide-realpath is not installed. Run ide-realpath-setup first.\n' >&2
    exit 127
fi

exec "$runtime" --terminal "${1:-}"
