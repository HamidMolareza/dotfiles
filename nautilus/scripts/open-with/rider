#!/usr/bin/env bash
# ide-realpath-portable-nautilus

set -Eeuo pipefail

runtime="${XDG_DATA_HOME:-$HOME/.local/share}/ide-realpath/ide-realpath-setup"
if [[ ! -x "$runtime" ]]; then
    message="ide-realpath is not installed. Run ide-realpath-setup first."
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --text="$message" || true
    fi
    printf 'Error: %s\n' "$message" >&2
    exit 127
fi

exec "$runtime" --run rider "$@"
