#!/usr/bin/env bash

set -Eeuo pipefail

show_help() {
  cat <<'EOF'
Usage: gapcodex [OPTIONS] [PROMPT]

Special behavior:
  Without --model, the model picker opens by default
  --model, -m    Open an interactive picker for a supported model

Supported models:
  gpt-5.6-sol (default)  Latest frontier agentic coding model.
  claude-opus-4-8       Anthropic's most capable model — excels at complex reasoning, analysis, and nuanced tasks.
  glm-5.2               Z.ai model on par with Claude Opus, uses significantly less quota.
  kimi-2.7              Kimi's latest coding model with strong reasoning and agentic performance.
  gapgpt-qwen-3.6       Locally hosted — all traffic stays in Iran. Best for latency-sensitive or data-sovereign workloads.
  claude-sonnet-5       Anthropic's latest Sonnet model for coding, agents, and professional work.
  gpt-5.6-terra         Balanced GPT-5.6 coding model for everyday agentic work.
  gpt-5.6-luna          Fast, efficient GPT-5.6 coding model.
  gpt-5.3-codex-spark   Ultra-fast coding model.
  gpt-5.5               Frontier agentic coding model.
  gpt-5.4               OpenAI's cheaper frontier agentic coding model.

Examples:
  gapcodex
  gapcodex --model
  gapcodex -m
  gapcodex --model gpt-5.6-sol
EOF
}

pick_model() {
  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 is required for the interactive model picker." >&2
    exit 1
  fi

  python3 /dev/fd/3 3<<'PY'
import sys
from typing import List, Tuple

MODELS = [
    ("gpt-5.6-sol", "Latest frontier agentic coding model."),
    (
        "claude-opus-4-8",
        "Anthropic's most capable model — excels at complex reasoning, analysis, and nuanced tasks.",
    ),
    ("glm-5.2", "Z.ai model on par with Claude Opus, uses significantly less quota."),
    ("kimi-2.7", "Kimi's latest coding model with strong reasoning and agentic performance."),
    (
        "gapgpt-qwen-3.6",
        "Locally hosted — all traffic stays in Iran. Best for latency-sensitive or data-sovereign workloads.",
    ),
    (
        "claude-sonnet-5",
        "Anthropic's latest Sonnet model for coding, agents, and professional work.",
    ),
    ("gpt-5.6-terra", "Balanced GPT-5.6 coding model for everyday agentic work."),
    ("gpt-5.6-luna", "Fast, efficient GPT-5.6 coding model."),
    ("gpt-5.3-codex-spark", "Ultra-fast coding model."),
    ("gpt-5.5", "Frontier agentic coding model."),
    ("gpt-5.4", "OpenAI's cheaper frontier agentic coding model."),
]
DEFAULT_MODEL = MODELS[0][0]
MODEL_NAME_WIDTH = max(
    len(f"{model_id} (default)" if model_id == DEFAULT_MODEL else model_id)
    for model_id, _ in MODELS
)

Model = Tuple[str, str]


def fail(message: str, exit_code: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(exit_code)


def model_label(model_id: str, description: str) -> str:
    display_name = f"{model_id} (default)" if model_id == DEFAULT_MODEL else model_id
    return f"{display_name:<{MODEL_NAME_WIDTH}}  {description}"


def fallback_choice(models: List[Model], tty_input, tty_output) -> str:
    print(
        "prompt_toolkit is not installed; falling back to a numbered model picker.",
        file=sys.stderr,
    )
    tty_output.write("GapCodex model picker\n")
    for index, (model_id, description) in enumerate(models, start=1):
        tty_output.write(f"  {index}. {model_label(model_id, description)}\n")
    tty_output.flush()

    while True:
        tty_output.write(f"Select a model [1-{len(models)}] (Ctrl-C cancels): ")
        tty_output.flush()
        selection = tty_input.readline()
        if selection == "":
            fail("Interactive model picker was interrupted.", exit_code=130)
        selection = selection.strip()
        if not selection:
            continue
        if selection.isdigit():
            selected_index = int(selection)
            if 1 <= selected_index <= len(models):
                return models[selected_index - 1][0]
        tty_output.write("Invalid selection. Please enter one of the listed numbers.\n")
        tty_output.flush()


def prompt_toolkit_choice(models: List[Model], tty_input, tty_output) -> str:
    from prompt_toolkit.application.current import create_app_session
    from prompt_toolkit.input.defaults import create_input
    from prompt_toolkit.output.defaults import create_output
    from prompt_toolkit.shortcuts import choice
    from prompt_toolkit.styles import Style

    style = Style.from_dict(
        {
            "frame.border": "#334155",
            "frame.label": "bold #93c5fd",
            "text-area": "bg:#111827 #e5e7eb",
            "text-area.prompt": "bold #fbbf24",
            "selected-option": "bg:#22c55e #052e16 bold",
            "line": "#94a3b8",
            "bottom-toolbar": "bg:#0f172a #cbd5e1",
        }
    )

    tty_ui_input = create_input(stdin=tty_input, always_prefer_tty=True)
    tty_ui_output = create_output(stdout=tty_output, always_prefer_tty=True)

    try:
        with create_app_session(input=tty_ui_input, output=tty_ui_output):
            result = choice(
                message="GapCodex model picker",
                options=[
                    (model_id, model_label(model_id, description))
                    for model_id, description in models
                ],
                default=DEFAULT_MODEL,
                style=style,
                symbol=">",
                show_frame=True,
                bottom_toolbar="Enter selects  Ctrl-C cancels",
            )
    except KeyboardInterrupt:
        fail("Interactive model picker was cancelled.", exit_code=130)
    finally:
        tty_ui_input.close()

    if result is None:
        fail("Interactive model picker was cancelled.", exit_code=130)

    return result


def main() -> None:
    try:
        tty_input = open("/dev/tty", "r", encoding="utf-8")
        tty_output = open("/dev/tty", "w", encoding="utf-8")
    except OSError:
        fail(
            "Interactive model picker requires a terminal. Run gapcodex from an interactive shell or pass an explicit --model value."
        )

    try:
        try:
            selected_model = prompt_toolkit_choice(MODELS, tty_input, tty_output)
        except ImportError:
            selected_model = fallback_choice(MODELS, tty_input, tty_output)
    finally:
        tty_input.close()
        tty_output.close()

    print(selected_model)


main()
PY
}

args=()
pick_requested=false
model_provided=false
model_value=""

while (($# > 0)); do
  case "$1" in
    --model=*|-m=*)
      args+=("$1")
      model_provided=true
      shift
      ;;
    --model|-m)
      if [[ -n "${2:-}" && "${2:-}" != -* ]]; then
        args+=("$1" "$2")
        model_provided=true
        shift 2
        continue
      fi
      pick_requested=true
      shift
      ;;
    --help|-h)
      show_help
      echo
      exec env \
        codex --profile gapcode "$@"
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

if [[ "$model_provided" == false && "$pick_requested" == false ]]; then
  pick_requested=true
fi

if [[ "$pick_requested" == true ]]; then
  model_value="$(pick_model)"
  args=(--model "$model_value" "${args[@]}")
fi

exec env \
  codex --profile gapcode "${args[@]}"
