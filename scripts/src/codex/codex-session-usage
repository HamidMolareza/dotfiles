@dataclass
class TaskDetail:
    key: str
    title: str
    first_seen_at: datetime | None = None
    last_seen_at: datetime | None = None
    phase_count: int = 0
    main_tokens: TokenBreakdown = field(default_factory=TokenBreakdown)
    subagent_tokens: TokenBreakdown = field(default_factory=TokenBreakdown)
    agent_ids: list[str] = field(default_factory=list)

    @property
    def total_tokens(self) -> TokenBreakdown:
        combined = self.main_tokens.copy()
        combined.add(self.subagent_tokens)
        return combined


