)
STATE_DB_RE = re.compile(r"state_(\d+)\.sqlite")
SESSION_ID_RE = re.compile(r"[0-9a-f-]+", re.IGNORECASE)
SENSITIVE_ASSIGNMENT_RE = re.compile(
    r"(?i)\b(api[_-]?key|access[_-]?token|refresh[_-]?token|password|secret|authorization)"
    r"(\s*[:=]\s*)([^\s,;]+)"
)
BEARER_TOKEN_RE = re.compile(r"(?i)\bbearer\s+[a-z0-9._~+/=-]+")
UNATTRIBUTED_TASK_KEY = "__unattributed__"
UNATTRIBUTED_TASK_TITLE = "Session setup / unattributed"
