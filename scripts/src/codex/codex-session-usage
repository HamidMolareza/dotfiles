class UsageReportError(RuntimeError):
    pass


@dataclass(frozen=True)
class StateDatabase:
    path: Path
    has_name_column: bool
    thread_columns: frozenset[str]


@dataclass(frozen=True)
class CandidateRollout:
    thread_id: str
    path: Path


@dataclass
class SessionReport:
    thread_id: str
    title: str
    display_title: str
    cwd: str
    created_at_ms: int | None
    updated_at_ms: int
    recency_at_ms: int
    main_tokens: int
    subagent_tokens: int
    total_tokens: int
    subagent_count: int
    window_tokens: int = 0
    window_share_percent: float = 0.0
    rank: int = 0

    @property
    def duration_seconds(self) -> int | None:
        if self.created_at_ms is None or self.created_at_ms <= 0 or self.updated_at_ms <= 0:
            return None
        return max((self.updated_at_ms - self.created_at_ms) // 1000, 0)


@dataclass
class TokenBreakdown:
    total_tokens: int = 0
    input_tokens: int = 0
    cached_input_tokens: int = 0
    output_tokens: int = 0
    reasoning_output_tokens: int = 0

    def add(self, other: TokenBreakdown) -> None:
        self.total_tokens += other.total_tokens
        self.input_tokens += other.input_tokens
        self.cached_input_tokens += other.cached_input_tokens
        self.output_tokens += other.output_tokens
        self.reasoning_output_tokens += other.reasoning_output_tokens

    def copy(self) -> TokenBreakdown:
        return TokenBreakdown(**self.to_dict())

    def to_dict(self) -> dict[str, int]:
        return {
            "total_tokens": self.total_tokens,
            "input_tokens": self.input_tokens,
            "cached_input_tokens": self.cached_input_tokens,
            "output_tokens": self.output_tokens,
            "reasoning_output_tokens": self.reasoning_output_tokens,
        }


@dataclass(frozen=True)
class DetailThread:
