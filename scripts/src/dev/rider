#!/usr/bin/env bash
# ide-realpath-adapter

set -Eeuo pipefail

RUNTIME="${XDG_DATA_HOME:-$HOME/.local/share}/ide-realpath/ide-realpath-setup"

if [[ ! -x "$RUNTIME" ]]; then
    echo "Error: ide-realpath is not installed. Run ide-realpath-setup first." >&2
    exit 127
fi

exec "$RUNTIME" --run rider "$@"
